      "EnableSsl": true,
      "Username": "",
      "Password": ""
    }
  },

  "FileUploads": {
    "Images": {
      "MaxBytes": 5242880
    }
  },

  "LessonContentAccess": {
    "AccessUrlLifetimeMinutes": 30
  },

